# API keys
INFERSPORTS_API_KEY=your_infersports_key_here
HIGHLIGHTLY_API_KEY=your_highlightly_key_here

# Optional Gemini AI analyst (disabled by default)
GEMINI_AI_ENABLED=0
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12

# Telegram
# Full token from BotFather, format: 123456789:AA...
TELEGRAM_BOT_TOKEN=123456789:your_bot_secret_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional only if you intentionally store token secret without numeric bot id:
# TELEGRAM_BOT_ID=123456789

# Database (optional)
DATABASE_PATH=gool_bot.db
