# Telegram
TELEGRAM_BOT_TOKEN=123456789:your_bot_secret_here
TELEGRAM_CHAT_ID=your_chat_id_here

# External football analytics
GOAL_API_KEY=your_goal_api_key_here
GOAL_DAILY_SOFT_CAP=850
# Start deep GOAL/FotMob/365Scores enrichment before a match reaches entry level.
ENRICH_MIN_MASTER=50

# Optional external odds confirmation/display. Bot works without this key.
SPORTSGAMEODDS_KEY=
SPORTSGAMEODDS_TTL=180

# Runtime
LIVE_SIGNAL_THRESHOLD=75
LIVE_COOLDOWN_MINUTES=12
LIVE_INTERVAL_SECONDS=60
# Cheap LIVE-statistics floor before full CORE/history/external analysis.
CORE_ANALYSIS_PREFILTER=38

# Optional storage
DATABASE_PATH=gool_bot.db
